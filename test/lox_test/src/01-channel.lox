var chnl = channel();
fun sender(){
    for(var x = 0; x< 10; x = x+1){
        send(chnl, x);
    }
    close(chnl);
}
fun receiver(){
    var flag = true;
    while(flag){
        var res = recv(chnl);
        if(res == nil){
            flag = false;
        }else{
            print res;
        }
    }
}
fun main(){
    var x = future sender();
    var y = future receiver();
    await x;
    await y; 
}
main();