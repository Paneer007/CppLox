var temp = 0;
var mut = mutex();

fun waitForMe(){
    var j = 0;
    print temp;
    var adjMat = [];
    for (var i = 0;i<10000;i = i+1){
        append(adjMat, i);
    }
    pfor(var a: adjMat){
        // lock(mut);
        temp = temp + 1;
        // unlock(mut);
    }
    return 1;
}

fun main(){
    var x = future waitForMe();
    print x;
    print temp;
    var res = await x;
    print res;
    print temp;
}

main();